<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RemoteLoader</AssemblyName>
    <!-- Suppress nullable warnings if building against net472 refs -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The evasion bypass is a SEPARATE assembly (AmsiBypass/). Keep it out of
         the loader's compile so it ships as its own library to host remotely. -->
    <Compile Remove="AmsiBypass\**" />
    <None Remove="AmsiBypass\**" />
    <EmbeddedResource Remove="AmsiBypass\**" />
    <!-- The xUnit test project is a separate solution member; never compile it
         into the loader binary. -->
    <Compile Remove="RemoteLoader.Tests\**" />
    <None Remove="RemoteLoader.Tests\**" />
    <EmbeddedResource Remove="RemoteLoader.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Let the test project reach the internal REPL (ArtifactCli). The
         catalog/normalizer/resolver types are already public. -->
    <InternalsVisibleTo Include="RemoteLoader.Tests" />
  </ItemGroup>
</Project>
