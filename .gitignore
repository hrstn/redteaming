# --- macOS ---
.DS_Store
**/.DS_Store

# --- Local deploy / staging copies (never repo content) ---
/Server/
NaX/src_server/agent_nonameax/agent

# --- hostpayload / hostpayload_v2 generated outputs ---
hostpayload/*.ps1
hostpayload_v2/*.exe

# --- Agent state / instructions — never commit to a public repo ---
.claude/
**/.claude/
CLAUDE.md
**/CLAUDE.md

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*~

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/

# --- Tool-call receipt directories (agent wrapper) ---
receipts/
**/receipts/

# --- Project-generated test artifacts (regenerable; do not ship) ---
hostpayload_v2/tests/*.bin
hostpayload_v2/tests/*.exe
hostpayload_v2/tests/benign_dropper.c
remote_bof_loader/tests/*.o

# --- BOF build outputs (regenerable COFFs; per-suite _bin/) ---
# NOTE: do NOT glob *.o here — several projects (C2-Tool-Collection,
# BOFKatz, GodPotatoBOF) intentionally ship prebuilt .o COFFs.
_bin/

# --- .NET / Visual Studio (PrivescCheckExe, RemoteLoader, ...) ---
# Build outputs (regenerable). .gitignore only affects UNTRACKED files, so any
# already-committed bin/obj artifacts remain tracked — this just keeps new
# build cruft out of the index.
[Bb]in/
[Oo]bj/
[Pp]ublish/
[Pp]ublished/
[Oo]ut/
[Bb]uild/
# Test / coverage results
[Tt]est[Rr]esults/
[Cc]overage/
*.coverage
*.coveragexml
coverage*.xml
coverage*.info
# NuGet
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
.nuget/
packages/
project.lock.json
project.fragment.lock.json
project.assets.json
artifacts/
# Rider / R# / Roslyn
*.sln.docstates
*.user
*.suo
*.userosscache
*.userprefs
*.rsuser
*.ide.meta
# Visual Studio per-user / temp
.vs/
*.tmp
*.tmp_proj
*.cache
*.binlog
*.tlog
*.pidb
*.svclog
# Publish / single-file staging
*.dll.config
*.exe.config
# .NET CLI temp
*.swp
*.bak
*.orig
# Blazor / web (harmless to include even if unused)
wwwroot/dist/
node_modules/
# --- Stray built test binaries (sources tracked; rebuild with mingw) ---
dpapi_credman.exe
NaX/src_loader/scripts/*.exe
