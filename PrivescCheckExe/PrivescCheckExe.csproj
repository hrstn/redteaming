<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- NativeAOT requires a base TFM without -windows suffix -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HostAudit</AssemblyName>
    <RootNamespace>PrivescCheckExe</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- NativeAOT: produces a single true-native PE - no IL to reflectively
         scan, no single-file temp-folder extraction, no managed assembly. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Trim away everything we don't reference (AOT does this by default). -->
    <TrimMode>full</TrimMode>
  </PropertyGroup>

</Project>